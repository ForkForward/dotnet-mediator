<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Authors, Company, Product and Copyright come from Directory.Build.props. -->
    <Description>ForkForward.Mediator is a community fork of MediatR, the simple mediator implementation in .NET created by Jimmy Bogard. It continues the last Apache-2.0-licensed code of MediatR (12.5.0): the assembly, the namespace and the API are those of MediatR 12.5.0. Independent project: not affiliated with or endorsed by the original authors.</Description>
    <TargetFrameworks>netstandard2.0;net6.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <Features>strict</Features>
    <!-- The package has the fork's own name. The assembly name, the namespace and the signing key are still
         the original ones; see ROADMAP.md, phase 2. -->
    <PackageId>ForkForward.Mediator</PackageId>
    <PackageTags>mediator;request;response;queries;commands;notifications;mediatr;fork;forkforward</PackageTags>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\MediatR.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ForkForward/dotnet-mediator</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/ForkForward/dotnet-mediator/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <!-- The version comes from the git tags: a tag v12.6.0 builds 12.6.0, a tag v12.6.0-preview.1 builds 12.6.0-preview.1.
         Commits after the last tag build a preview, for example 12.6.0-preview.0.4 for the fourth commit after it.
         The minimum keeps the fork's versions above the original 12.5.0 it was forked from. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>12.6</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="" Visible="False" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="" />
    <!-- The licence and the attribution notice travel with every copy of the package. -->
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="False" />
    <None Include="..\..\NOTICE.md" Pack="true" PackagePath="" Visible="False" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contracts come from this repository and are published as ForkForward.Mediator.Contracts.
         In the package this reference becomes a dependency on that package; see the target below. -->
    <ProjectReference Include="..\MediatR.Contracts\MediatR.Contracts.csproj" />
  </ItemGroup>

  <!-- Pack turns a project reference into a dependency on "this version or newer". The mediator and its
       contracts are released together, so the dependency is pinned to exactly the contracts version built
       here, [2.6.0]: no other contracts version can be resolved for this package.
       _GetProjectReferenceVersions and _ProjectReferencesWithVersions belong to NuGet's pack targets and are
       not a public contract; the release workflow checks the resulting dependency before anything is published. -->
  <Target Name="PinContractsDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(_ProjectReferencesWithVersions.ProjectVersion)' != ''">
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>

<Project>
  <Import Project="..\Directory.Build.props" />

  <!-- What the two published projects, ForkForward.Mediator and ForkForward.Mediator.Contracts, have in common. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <Features>strict</Features>
    <!-- Runtime async: on .NET 11 the runtime runs async methods itself, without a compiler-generated state machine,
         which gives shorter stack traces and less overhead per await. It needs the .NET 11 runtime, so it is on for
         the net11.0 assets only; the net10.0 assets keep the state machines. The source is the same for both. -->
    <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The fork's own strong-name key. The original MediatR key is no longer in the repository. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\ForkForward.Mediator.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- One version for both packages, taken from the git tags: a tag v13.0.0 builds 13.0.0, a tag
         v13.1.0-preview.1 builds 13.1.0-preview.1. Commits after the last tag build a preview, for example
         13.0.1-preview.0.4 for the fourth commit after v13.0.0.
         The minimum is the current major line, 13: it targets .NET 10 and .NET 11 only. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>13.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <PackageTags>mediator;request;response;queries;commands;notifications;mediatr;fork;forkforward</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <!-- The documentation site; nuget.org shows it as the project website. The source link comes from PublishRepositoryUrl. -->
    <PackageProjectUrl>https://forkforward.dev/dotnet-mediator/</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/ForkForward/dotnet-mediator/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="" Visible="False" />
    <None Include="$(MSBuildProjectDirectory)\PACKAGE.md" Pack="true" PackagePath="" />
    <!-- The licence and the attribution notice travel with every copy of the packages. -->
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="" Visible="False" />
    <None Include="$(MSBuildThisFileDirectory)..\NOTICE.md" Pack="true" PackagePath="" Visible="False" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source Link needs no package: it has been part of the .NET SDK since version 8. -->
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>

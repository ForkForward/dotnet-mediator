<Project>
  <PropertyGroup>
    <!-- Who publishes this fork. The original authors are credited in Copyright, in the package description and in NOTICE.md. -->
    <Authors>ForkForward</Authors>
    <Company>ForkForward</Company>
    <Product>ForkForward.Mediator (fork of MediatR)</Product>
    <Copyright>Copyright Jimmy Bogard and MediatR contributors. Modifications copyright 2026 ForkForward contributors.</Copyright>
    <!-- All build output goes to /artifacts instead of bin and obj folders next to each project:
         artifacts/bin/<project>/<configuration>, artifacts/obj/<project>, artifacts/package/<configuration>. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- Said explicitly: without it the projects below src/, which have a Directory.Build.props of their own,
         would write to src/artifacts. -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <!-- No LangVersion: each target framework gets the C# version the SDK pairs with it, C# 14 for net10.0 and
         C# 15 for net11.0. Code that has to compile for both uses what both have. -->
    <NoWarn>$(NoWarn);CS1701;CS1702;CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
